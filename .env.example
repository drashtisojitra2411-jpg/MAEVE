# ==============================================================================
# MAEVE — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your deployment environment.
# Never commit active secrets or production credentials to version control.

# Server Port
PORT=8787

# Node Environment: 'production' | 'development' | 'test'
NODE_ENV=production

# Cryptographic Session Secret
# REQUIRED in production. Generate a high-entropy secret (e.g. openssl rand -base64 32).
MAEVE_SESSION_SECRET=replace-with-a-secure-random-32-byte-hex-or-base64-secret

# Persistent Storage Directories
# On containers/VMs, mount a persistent volume at MAEVE_DATA_DIR to survive container restarts.
MAEVE_DATA_DIR=./server/data
MAEVE_DB=./server/data/maeve.db

# Cross-Origin Resource Sharing (CORS)
# Set to your frontend domain in production (e.g. https://maeve.fashion) or comma-separated origins.
# Leave blank for same-origin reverse-proxy setups (recommended).
MAEVE_CORS_ORIGIN=

# Rate Limiting
# '1' to enforce rate limiting on auth endpoints (default), '0' to disable in CI/testing.
MAEVE_RATE_LIMIT=1

# Computer Vision Pipeline & DeepFashion2 Model
# Path to YOLOv8s-seg DeepFashion2 model weights
MAEVE_MODEL_PATH=./server/cv/models/deepfashion2_yolov8s-seg.pt

# Python Runtime Interpreter
# By default, MAEVE will automatically discover ./server/cv/.venv/Scripts/python.exe
# or ./server/cv/.venv/bin/python. Override here if using an external environment.
MAEVE_PYTHON=

# Detection Confidence Thresholds (0.0 to 1.0)
MAEVE_MIN_CONF=0.30
MAEVE_CONFIRM_CONF=0.60

# Frontend Configuration (Client-Side)
# Leave empty if the frontend is served from the same host/reverse-proxy as the API.
# Set if the frontend is deployed to a separate host (e.g., https://api.maeve.fashion).
VITE_API_URL=
